# ==============================================================
# AIDERS - Real Google Firebase Authentication Environment Setup
# ==============================================================
# To get these credentials:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Click "Add Project" (e.g. "AIDERS-Disaster-System")
# 3. Go to "Authentication" > "Get Started" > enable "Google" sign-in provider.
# 4. Click Project Settings (Gear icon) > General > "Your apps" > Web app (</>)
# 5. Copy the config values here:

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Backend API URL (defaults to http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000
